{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListRawTlcOnly",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::__BUCKET__",
      "Condition": { "StringLike": { "s3:prefix": ["raw/tlc/*"] } }
    },
    {
      "Sid": "ReadRawTlcOnly",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion"],
      "Resource": "arn:aws:s3:::__BUCKET__/raw/tlc/*"
    }
  ]
}
