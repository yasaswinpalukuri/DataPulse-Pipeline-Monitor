# Install:  (crontab -l; cat deploy/crontab) | crontab -
# Paths below assume the repo is at /home/groot/projects/DataPulse-Pipeline-Monitor.
0 21 * * * /home/groot/projects/DataPulse-Pipeline-Monitor/scripts/run_daily.sh
