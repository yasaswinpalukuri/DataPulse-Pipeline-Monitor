{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListCuratedStar",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::__BUCKET__",
      "Condition": { "StringLike": { "s3:prefix": ["curated/star/*"] } }
    },
    {
      "Sid": "ReadCuratedStarOnly",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::__BUCKET__/curated/star/*"
    }
  ]
}
