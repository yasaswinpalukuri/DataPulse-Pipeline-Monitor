# Snowflake
SNOWFLAKE_ACCOUNT=xxx.snowflakecomputing.com
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_DATABASE=DATAPULSE
SNOWFLAKE_SCHEMA=RAW
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=ACCOUNTADMIN

# AWS: credentials are NEVER put here. The laptop uses ~/.aws/credentials
# (aws configure, IAM user yasaswin-admin); scripts/aws/env.sh derives the
# bucket name. Redshift is reached through the Data API with IAM -- no
# host, port or database password needed.

# Docker port binding for the api/dashboard services (see docker-compose.yml).
# Default 127.0.0.1 = this machine only. On Groot, set to the Tailscale IP.
BIND_ADDR=127.0.0.1

# S3 raw zone read by Snowflake's COPY INTO (scripts/aws/env.sh prints it)
DATAPULSE_BUCKET=

# App
# Slack Incoming Webhook -- this URL IS the credential; never commit it
SLACK_WEBHOOK_URL=
# Row-level check failure rate above which Slack gets a warning (0.05 = 5%)
ROW_ALERT_THRESHOLD=0.05
# Optional: cap rows per run for quick tests (unset = full day, ~80-110k rows)
MAX_RECORDS=
